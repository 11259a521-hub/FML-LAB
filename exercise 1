import numpy as np


# ============================================================
# 1. Print NumPy version
# ============================================================
def program1():
    print("NumPy Version:")
    print(np.__version__)


# ============================================================
# 2. Different types of arrays
# ============================================================
def program2():
    # One-dimensional array
    print("One-dimensional array:")
    x = np.arange(2, 6).reshape(4)
    print(x)

    # Two-dimensional array
    print("\nTwo-dimensional array:")
    x = np.arange(2, 10).reshape(2, 4)
    print(x)

    # Three-dimensional array
    print("\nThree-dimensional array:")
    x = np.arange(24).reshape(4, 3, 2)
    print(x)


# ============================================================
# 3. Array slicing
# ============================================================
def program3():
    arr = np.array([1, 2, 3, 4])

    print("arr[1:3:2]:")
    print(arr[1:3:2])

    print("arr[:3]:")
    print(arr[:3])

    print("arr[::2]:")
    print(arr[::2])


# ============================================================
# 4. Trigonometric functions
# ============================================================
def program4():
    arr = np.array([0, 30, 60, 90])

    print("Sin:")
    print(np.sin(arr))

    print("Cos:")
    print(np.cos(arr))

    print("Tan:")
    print(np.tan(arr))


# ============================================================
# 5. List to one-dimensional NumPy array
# ============================================================
def program5():
    l = [12.23, 13.32, 100, 36.32]

    print("Original List:", l)

    a = np.array(l)

    print("One-dimensional NumPy array:", a)


# ============================================================
# 6. Array with values from 12 to 38
# ============================================================
def program6():
    x = np.arange(12, 38)

    print(x)


# ============================================================
# 7. Reverse an array
# ============================================================
def program7():
    x = np.arange(12, 38)

    print("Original array:")
    print(x)

    print("Reverse array:")
    x = x[::-1]
    print(x)


# ============================================================
# 8. Append values to an array
# ============================================================
def program8():
    x = [10, 20, 30]

    print("Original array:")
    print(x)

    x = np.append(x, [[40, 50, 60], [70, 80, 90]])

    print("After append:")
    print(x)


# ============================================================
# 9. Common values between two arrays
# ============================================================
def program9():
    array1 = np.array([0, 10, 20, 40, 60])

    print("Array1:", array1)

    array2 = [10, 30, 40]

    print("Array2:", array2)

    print("Common values:")
    print(np.intersect1d(array1, array2))


# ============================================================
# 10. Union of two arrays
# ============================================================
def program10():
    array1 = np.array([0, 10, 20, 40, 60, 80])

    print("Array1:", array1)

    array2 = [10, 30, 40, 50, 70]

    print("Array2:", array2)

    print("Union:")
    print(np.union1d(array1, array2))


# ============================================================
# 11. Concatenate two 2D arrays
# ============================================================
def program11():
    a = np.array([
        [0, 1, 3],
        [5, 7, 9]
    ])

    b = np.array([
        [0, 2, 4],
        [6, 8, 10]
    ])

    c = np.concatenate((a, b), axis=1)

    print(c)


# ============================================================
# 12. Fahrenheit and Centigrade conversion
# ============================================================
def program12():
    # Fahrenheit to Centigrade
    fvalues = [0, 12, 45.21, 34, 99.91, 32]

    F = np.array(fvalues)

    print("Values in Fahrenheit:")
    print(F)

    print("Values in Centigrade:")
    print(np.round((5 * F / 9 - 5 * 32 / 9), 2))

    # Centigrade to Fahrenheit
    cvalues = [-17.78, -11.11, 7.34, 1.11, 37.73, 0]

    C = np.array(cvalues)

    print("\nValues in Centigrade:")
    print(C)

    print("Values in Fahrenheit:")
    print(np.round((9 * C / 5 + 32), 2))


# ============================================================
# 13. Arithmetic operations
# ============================================================
def program13():
    a = np.arange(9, dtype=float).reshape(3, 3)

    print("First Array:")
    print(a)

    b = np.array([10, 20, 30])

    print("\nSecond Array:")
    print(b)

    print("\nAddition:")
    print(np.add(a, b))

    print("\nSubtraction:")
    print(np.subtract(a, b))

    print("\nMultiplication:")
    print(np.multiply(a, b))

    print("\nDivision:")
    print(np.divide(a, b))


