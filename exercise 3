# 12. Word Frequency Analysis
def program12():
    feedback = "good service good quality excellent service"

    words = feedback.split()

    for word in set(words):
        print(word, ":", words.count(word))


# 13. Age Group Classification
def program13():
    ages = [12, 25, 45, 67, 15]

    for age in ages:
        if age < 18:
            print(age, "Child")
        elif age < 60:
            print(age, "Adult")
        else:
            print(age, "Senior Citizen")


# 14. Electricity Bill Calculation
def program14():
    units = 250

    if units <= 100:
        bill = units * 2

    elif units <= 200:
        bill = 100 * 2 + (units - 100) * 3

    else:
        bill = 100 * 2 + 100 * 3 + (units - 200) * 5

    print("Electricity Bill:", bill)


# 15. Monthly Expense Analysis
def program15():
    expenses = [12000, 15000, 18000, 11000, 17000]

    highest = max(expenses)

    month = expenses.index(highest) + 1

    print("Highest Expense:", highest)
    print("Month:", month)


