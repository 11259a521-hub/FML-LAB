    print("Total Sales:", sum(sales))
    print("Average Sales:", sum(sales) / len(sales))


# 4. Even and Odd Employee IDs
def program4():
    ids = [101, 102, 103, 104, 105, 106]

    even = []
    odd = []

    for i in ids:
        if i % 2 == 0:
            even.append(i)
        else:
            odd.append(i)

    print("Even IDs:", even)
    print("Odd IDs:", odd)


# 5. Count Positive and Negative Values
def program5():
    values = [20, -5, 15, -10, 30, -2]

    positive = 0
    negative = 0

    for i in values:
        if i > 0:
            positive += 1
        elif i < 0:
            negative += 1

    print("Positive Values:", positive)
    print("Negative Values:", negative)


# 6. Find Duplicate Customer IDs
def program6():
    customer_ids = [101, 102, 103, 102, 104, 105, 101]

    duplicates = []

    for i in customer_ids:
        if customer_ids.count(i) > 1 and i not in duplicates:
            duplicates.append(i)

    print("Duplicate IDs:", duplicates)


